{
  "manifest_version": 2,
  "version": "1.4.1",
  "name": "睡眠管理Next",
  "description": "当 Bot 在合适时间主动说出晚安或准备睡觉时，进入临时睡眠状态，并在睡眠期间暂停新消息、表达学习、Planner 结果和出站消息",
  "author": {
    "name": "ValleyWinds",
    "url": "https://github.com/ValleyWinds"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/ValleyWinds/Sleep-Manager-Next",
    "homepage": "https://github.com/ValleyWinds/Sleep-Manager-Next",
    "documentation": "https://github.com/ValleyWinds/Sleep-Manager-Next",
    "issues": "https://github.com/ValleyWinds/Sleep-Manager-Next/issues"
  },
  "host_application": {
    "min_version": "1.2.5",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "changelog": "CHANGELOG.md",
  "capabilities": [
    "send.text",
    "llm.generate",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "locales_path": "i18n",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "id": "valleywinds.sleep-manager"
}
